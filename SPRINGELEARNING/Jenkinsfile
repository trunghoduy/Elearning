pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    environment {
        IMAGE_NAME = "springelearning"
        IMAGE_TAG  = "latest"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/trunghoduy/Elearning.git'
            }
        }

        stage('Build & Test') {
            steps {
                dir('SPRINGELEARNING') {
                    sh 'mvn clean package -DskipTests=false'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('SPRINGELEARNING') {
                    sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .'
                }
            }
        }

        stage('Docker Run') {
            steps {
                sh 'docker stop ${IMAGE_NAME} || true'
                sh 'docker rm ${IMAGE_NAME} || true'
                sh '''
                    docker run -d \
                      --name ${IMAGE_NAME} \
                      -p 2404:2404 \
                      ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }
    }

    post {
        success {
            echo '✅ Deploy thành công! App đang chạy tại port 2404'
        }
        failure {
            echo '❌ Pipeline thất bại, kiểm tra Console Output!'
        }
    }
}